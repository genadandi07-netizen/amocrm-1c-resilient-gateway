# amocrm-1c-resilient-gateway configuration.
# Every key is read by gateway/config.py (GATEWAY_<SECTION>_<PARAM> overrides
# config/gateway.json; scalar keys are listed below) or by scripts/egress_worker.py.
# Copy: `cp .env.example .env` — .env is gitignored.

# --- HTTP ------------------------------------------------------------------
# Applied ONLY when you run Uvicorn manually outside Docker. Inside the
# container the address is fixed: 0.0.0.0:8000 (docker-compose.yml publishes
# 127.0.0.1:8000 -> 8000), so editing these two keys has no effect on the stack.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- Resilience sections (mirror config/gateway.json; all validated) -------
# Circuit breaker for egress dependencies.
GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
GATEWAY_CIRCUIT_BREAKER_HALF_OPEN_PROBE_INTERVAL=5.0
# Replay protection window and in-memory nonce journal bound.
GATEWAY_REPLAY_GUARD_TIMESTAMP_WINDOW_SECONDS=300
GATEWAY_REPLAY_GUARD_NONCE_JOURNAL_SIZE=10000
# Exponential backoff: delay = min(base * multiplier^(n-1), max) * jitter.
GATEWAY_BACKOFF_BASE_SECONDS=0.5
GATEWAY_BACKOFF_MULTIPLIER=2.0
GATEWAY_BACKOFF_MAX_SECONDS=30.0
GATEWAY_BACKOFF_JITTER_RATIO=1.0
GATEWAY_BACKOFF_MAX_ATTEMPTS=5
# Ingress rate-limit bucket (algorithm: token_bucket or sliding_window).
GATEWAY_RATE_LIMIT_ALGORITHM=token_bucket
GATEWAY_RATE_LIMIT_REQUESTS_PER_WINDOW=100
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# --- Ingress security ------------------------------------------------------
# HMAC-SHA256 secret shared with the amoCRM relay. Generate: openssl rand -hex 32
GATEWAY_HMAC_SECRET=change-me-in-production
# API token presented by the 1C side on POST /webhook/onec via the
# X-Api-Token header (or `Authorization: Bearer <token>`). Leave empty to
# require HMAC signatures only. Generate: openssl rand -hex 32
GATEWAY_ONEC_API_TOKEN=

# --- Storage (shared by `gateway` and `egress-worker` through ./data:/app/data, WAL).
GATEWAY_DB_PATH=/app/data/gateway.db

# --- 1C OData (egress) -----------------------------------------------------
# Publication ROOT WITHOUT the /odata/standard.odata segment: the worker appends
# /odata/standard.odata/<Entity> itself (see docs/INTEGRATION_MANUAL.md, §3.2).
GATEWAY_ONEC_BASE_URL=http://1c-server:8314/base
# Entity paths appended to the root above (must start with "/"). Change them
# when a publication uses a different 1C configuration/entity name.
GATEWAY_ONEC_ORDER_PATH=/odata/standard.odata/Document_ЗаказПокупателя
GATEWAY_ONEC_COUNTERPARTY_PATH=/odata/standard.odata/Catalog_Контрагенты
# Shipped delivery-worker credentials: HTTP Basic for every OData request
# (used by scripts/egress_worker.py; if unset, requests go out unauthenticated).
GATEWAY_ONEC_USER=odata_gateway
GATEWAY_ONEC_PASSWORD=change-me-in-production
# Per-request timeout towards 1C, seconds (worker). Tune for slow OData bases
# per docs/INTEGRATION_MANUAL.md, §3.4.
GATEWAY_ONEC_TIMEOUT_SECONDS=15

# --- amoCRM API (egress: 1C -> amoCRM) -------------------------------------
# Root URL of the amoCRM account; the client appends the leads path below.
GATEWAY_AMOCRM_BASE_URL=https://example.amocrm.ru
# Leads API path appended to the root (must start with "/"); the lead id is
# appended after it, e.g. /api/v4/leads/123.
GATEWAY_AMOCRM_LEADS_PATH=/api/v4/leads
# Long-lived OAuth access token used as `Authorization: Bearer <token>`.
# Rotated single-flight on HTTP 401 (one refresh per rotation epoch).
GATEWAY_AMOCRM_ACCESS_TOKEN=
# Client-side rate limit (token bucket) in requests per second, default 100.
GATEWAY_AMOCRM_REQUESTS_PER_SECOND=100

# --- Egress pacing (token bucket, blocking) ---------------------------------
# The egress worker PACES both outbound legs: the token bucket sleeps between
# requests so 1C / amoCRM never see a burst. These values are independent of
# the amoCRM budget above (that one rejects, this one waits).
GATEWAY_ONEC_RATE_LIMIT_RPS=2.0
GATEWAY_ONEC_RATE_LIMIT_BURST=5
GATEWAY_AMOCRM_RATE_LIMIT_RPS=2.0
GATEWAY_AMOCRM_RATE_LIMIT_BURST=5

# --- n8n Dead Letter Queue (empty = DLQ disabled) --------------------------
GATEWAY_N8N_DLQ_URL=http://n8n:5678/webhook/dlq-fallback

# --- SQLite / delivery tuning ---------------------------------------------
# busy_timeout waits for a competing writer before SQLITE_BUSY is raised.
GATEWAY_BUSY_TIMEOUT_MS=5000
GATEWAY_DB_CONNECT_TIMEOUT_SECONDS=5.0
# Extra bounded retries when the busy_timeout budget is exhausted under load.
GATEWAY_DB_LOCK_RETRY_ATTEMPTS=6
GATEWAY_DB_LOCK_RETRY_BASE_SECONDS=0.05
GATEWAY_DB_LOCK_RETRY_MAX_SECONDS=0.5
GATEWAY_DISPATCH_BATCH_LIMIT=50
# A DISPATCHED event older than this lease is reclaimed by another worker
# (crash recovery). Keep it comfortably above one delivery attempt.
GATEWAY_DISPATCH_LEASE_SECONDS=300

# --- Background egress worker (scripts/egress_worker.py) ------------------
# Seconds between queue passes (aliases: POLL_INTERVAL, GATEWAY_WORKER_INTERVAL_SECONDS).
GATEWAY_POLL_INTERVAL=2
# DEBUG / INFO / WARNING / ERROR / CRITICAL
GATEWAY_LOG_LEVEL=INFO
# true = one JSON object per line (production); false = human-readable text.
GATEWAY_LOG_JSON=true
# Upper bound on per-IP rate-limit buckets kept in memory (LRU eviction).
GATEWAY_RATE_LIMIT_MAX_TRACKED_IPS=10000

# --- Docker entrypoint (scripts/docker_entrypoint.py) -----------------------
# Data directory prepared for the unprivileged user before the service starts.
# Override only if you mount the SQLite volume somewhere else.
# GATEWAY_DATA_DIR=/app/data
# Unprivileged user the container runs as after the entrypoint drops privileges.
# GATEWAY_APP_USER=appuser

# Optional: corporate CA for 1C/n8n behind a private TLS terminator
# (mount the file into the containers and point this variable at it).
# SSL_CERT_FILE=/etc/ssl/certs/corp-ca.pem
